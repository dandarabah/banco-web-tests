    "test1": "cypress run --env URL=http://localhost:4000 --reporter cypress-mochawesome-reporter",
    "test-qa": "cypress run --env URL=https://banco.com.br --reporter cypress-mochawesome-reporter",
    "test:prod": "cypress run --env URL=https://banco.com.br --reporter cypress-mochawesome-reporter",
    "cy:headed": "cypress run --headed --reporter cypress-mochawesome-reporter",
    "cy:open": "cypress open",
    "test:report": "cypress run --reporter cypress-mochawesome-reporter"
